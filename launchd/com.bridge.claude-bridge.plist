<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Watchdog keepalive. Runs scripts/watchdog.sh every 60s and at load.
  Before loading: edit the two <string>/PATH/TO/...</string> paths to absolutes.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bridge.claude-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/PATH/TO/YOUR/BRIDGE/scripts/watchdog.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/PATH/TO/YOUR/LOGS/watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/YOUR/LOGS/watchdog-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
