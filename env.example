# Copy to .env at the repo root and fill in.
# Scripts that source this will get consistent paths.

# Absolute path to this checkout
BRIDGE_HOME="${HOME}/my-bridge"

# Where logs accumulate (watchdog, jobs, hook delivery traces)
BRIDGE_LOG_DIR="${HOME}/bridge-logs"

# Name of the assistant (used in the watchdog restart message, etc.)
ASSISTANT_NAME="Assistant"

# tmux session name the watchdog manages
BRIDGE_SESSION_NAME="bridge"

# Launchd label prefix (e.g. com.bridge.job.foo)
BRIDGE_LABEL_PREFIX="com.bridge"

# --- Cashew brain (optional) ---
# Leave blank if you're not using cashew; hooks will gracefully no-op.
CASHEW_HOME="${HOME}/cashew"

# --- Telegram ---
# Your personal chat_id with the bot. Used by the watchdog to tell you it
# restarted, and by cron notify scripts. Get it by DMing the bot and reading
# message.from.id in any update.
TELEGRAM_CHAT_ID=""

# --- Discord (optional) ---
# Your Discord user ID. Used by cron/discord-notify.sh to DM you.
DISCORD_USER_ID=""

# --- Model choice for headless jobs ---
HEADLESS_MODEL="sonnet"
SESSION_MODEL="claude-opus-4-7"

# --- GOG / other per-tool secrets (if you use them) ---
# GOG_KEYRING_PASSWORD=""
